{
  "name": "sheafly",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26",
    "npm": ">=12"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "npm run dev -w @sheafly/server",
    "dev:client": "npm run dev -w @sheafly/client",
    "build": "npm run build -w @sheafly/client",
    "start": "npm start -w @sheafly/server",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "prettier": "3.9.10"
  }
}
